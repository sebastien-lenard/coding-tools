1. Create or fix unit tests using pytest. Address issues given in the --- Tips --- section, in this order: (1) errors, (2) fails, (3) warnings, (4) source coverage.
2. Don't edit code or clear comments or clear docstrings outside of your edits to address the issues.

## Examples of accepted pens and fixes:

```python
"""Patch calc helper module functions used by my_process"""
from unittest.mock import Mock
import pytest
from xxx_yyy import my_process

def test_assess_mocked_math(monkeypatch: pytest.MonkeyPatch) -> None:
    """Test calc runner with mocked core logic."""
    mock_add = Mock(return_value=42)
    mock_log = Mock()
    monkeypatch.setattr("xxx_yyy.calc.add", mock_add)
    monkeypatch.setattr("xxx_yyy.calc.log_step", mock_log)

    res = my_process.assess(2, 40)
    assert res == 42
    mock_log.assert_called_once()
```

```python
import os
from pathlib import Path

import pytest

from xxx_yyy import my_path

def test_live_path_errors(tmp_path: Path) -> None:
    with pytest.raises(FileNotFoundError):
        my_file.live_path(tmp_path / "missing", "*.txt")

    sub = tmp_path / "empty"
    sub.mkdir()
    with pytest.raises(FileNotFoundError):
        my_file.live_path(sub, "*.txt")

    with pytest.raises(ValueError, match="Bad characters in path"):
        my_file.live_path(tmp_path / "a?ver", "*.txt")

def test_main_entry_run_failure(monkeypatch: pytest.MonkeyPatch) -> None:
    """Test failure run via the main CLI."""
    test_args = ["bund.py", "missing_dir"]
    monkeypatch.setattr("sys.argv", test_args)

    with pytest.raises(SystemExit) as exc_info:
        my_path.main()
    
    assert exc_info.value.code == 1

def test_read_conf_pass(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Test good reading of config."""
    monkeypatch.chdir(tmp_path)
    conf_dir = tmp_path / "config"
    conf_dir.mkdir(parents=True)
    conf_file = conf_dir / "conf.jsonc"
    conf_file.write_text('{"default": "model-a"}', encoding="utf-8")

    cfg = read_conf()
    assert cfg["default"] == "model-a"
```

```python
import os
from pathlib import Path

import pytest

from xxx_yyy import my_fmt

@pytest.mark.parametrize(
    ("target", "full_path", "expected"),
    [
        (None, False, ""),
        (None, True, ""),
        ("", False, ""),
        ("", True, ""),
        (Path("file.py"), False, "file: "),
        (Path("file.py"), True, "file.py: "),
        (Path("folder") / "file.py", False, "file: "),
        (Path("folder") / "file.py", True, f"{Path('folder') / 'file.py'}: "),
        (Path("other.txt"), False, "other.txt: "),
        (Path("other.txt"), True, "other.txt: "),
    ],
)
def test_fmt(
    target: str | Path | None,
    full: bool,
    expected: str,
) -> None:
    """Test target formatting handles paths and extensions."""
    assert my_fmt.fmt(target, full=full) == expected
```


```python
def test_run_mod_as_main(
    tmp_path: Path,
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    """Checks module run using runpy path loading."""
    script = tmp_path / "main.py"
    script.write_text("pass", encoding="utf-8")
    monkeypatch.setattr(
        sys,
        "argv",
        ["show_license", str(script), "--no-license"],
    )

    target_path = str(Path(ws_module.__file__).resolve())

    with pytest.raises(SystemExit) as sysexit:
        runpy.run_path(target_path, run_name="__main__")
    assert sysexit.value.code == 0
```

```python
from unittest.mock import MagicMock, patch
import pytest

from this_project.this_client import ClientAdapter


class MockAPIError(Exception):
    """Global mock replacement for Google GenAI APIError."""

    def __init__(
        self,
        message: str | None = None,
        code: int = 400,
        status: str = "INVALID",
    ) -> None:
        super().__init__(message)
        self.message = message
        self.code = code
        self.status = status


def test_cleanup_files() -> None:
    """Test cleanup_files handles APIError."""
    api_err = MockAPIError(message="Del Fail", code=400)
    
    file_mock = MagicMock()
    file_mock.name = "file_name"

    mock_client_instance = MagicMock()
    mock_client_instance.files.delete.side_effect = api_err

    with (
        patch("this_project.this_client.Client", return_value=mock_client_instance),
        patch("google.genai.errors.APIError", MockAPIError),
    ):
        adapter = ClientAdapter()
        adapter.cleanup_files([file_mock], "TEST")

    mock_client_instance.files.delete.assert_called_once_with(
        name="file_name",
    )
```
